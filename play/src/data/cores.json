        "REGISTER"
      ],
      [
        "I-CSCF ⇄ HSS",
        "Diameter UAR / UAA (Cx)"
      ],
      [
        "I-CSCF → S-CSCF",
        "REGISTER"
      ],
      [
        "S-CSCF ⇄ HSS",
        "Diameter MAR / MAA · vetor AKA"
      ],
      [
        "S-CSCF → UE",
        "401 Unauthorized (nonce)"
      ],
      [
        "UE → S-CSCF",
        "REGISTER + resposta AKA"
      ],
      [
        "S-CSCF ⇄ HSS",
        "SAR / SAA · perfil do assinante"
      ],
      [
        "S-CSCF → UE",
        "200 OK · registrado"
      ],
      [
        "S-CSCF → TAS",
        "REGISTER de terceiros (MMTel)"
      ]
    ],
    "lte": [
      [
        "UE → MME",
        "Attach Request + PDN de internet"
      ],
      [
        "MME ⇄ HSS",
        "Autenticação EPS-AKA · Update Location"
      ],
      [
        "MME → S-GW → P-GW",
        "Create Session · bearer padrão"
      ],
      [
        "UE → MME",
        "PDN Connectivity · APN ims (QCI 5)"
      ],
      [
        "P-GW → UE",
        "endereço IP + endereço do P-CSCF"
      ],
      [
        "UE → P-CSCF",
        "REGISTER (via P-GW)"
      ],
      [
        "I-CSCF ⇄ HSS",
        "Diameter UAR / UAA (Cx)"
      ],
      [
        "S-CSCF ⇄ HSS",
        "MAR / MAA · vetor AKA"
      ],
      [
        "S-CSCF → UE",
        "401 Unauthorized (nonce)"
      ],
      [
        "UE → S-CSCF",
        "REGISTER + resposta AKA"
      ],
      [
        "S-CSCF → UE",
        "200 OK · registrado em VoLTE"
      ],
      [
        "S-CSCF → TAS",
        "REGISTER de terceiros (MMTel)"
      ]
    ],
    "srvcc": [
      [
        "UE em VoLTE",
        "chamada ativa na eNodeB do Site Echo"
      ],
      [
        "UE → eNodeB",
        "Medição B2: LTE fraco, GSM 900 forte"
      ],
      [
        "eNodeB → MME",
        "Handover Required (SRVCC)"
      ],
      [
        "MME → SRVCC IWF",
        "Sv: PS to CS Request"
