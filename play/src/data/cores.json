      ],
      [
        "BSC → BTS",
        "aloca um canal TCH no GSM 900"
      ],
      [
        "MSC → IMS (Echo)",
        "INVITE para o STN-SR · transfere a sessão"
      ],
      [
        "IWF → MME",
        "Sv: PS to CS Response"
      ],
      [
        "MME → UE",
        "Handover Command: vai para o GSM"
